+	XVisualInfo* vi = NULL;
+	XRenderPictFormat *pict_format;
+	GLXFBConfig fbconfig = 0, *fbconfigs;
+
+	fbconfig = 0;
+	int numfbconfigs;
+	fbconfigs = glXChooseFBConfig(impl->display, impl->screen, attrListDblMSAlpha, &numfbconfigs);
+
+	for (int i = 0; i < numfbconfigs; i++)
+	{
+		vi = (XVisualInfo*) glXGetVisualFromFBConfig(impl->display, fbconfigs[i]);
+		if (!vi)
+			continue;
+
+		pict_format = XRenderFindVisualFormat(impl->display, vi->visual);
+		if (!pict_format) {
+			XFree(vi);
+			continue;
+		}
+
+		fbconfig = fbconfigs[i];
+		if ((pict_format->direct.alphaMask > 0) == optAlpha)
+			break;
+	}
+
+	if (!fbconfig)
+	{
+		vi = glXChooseVisual(impl->display, impl->screen, attrListDblMS);
+#ifdef VERBOSE_PUGL
+		printf("puGL: background transparency is off or not available\n");
+#endif
+	}
 
