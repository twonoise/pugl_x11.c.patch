+/**
+   Attributes for double-buffered RGBA with multi-sampling
+	 antialiasing (MSAA) and background transparency (Alpha).
+   NOTE that, with _integrated_ GPU, it's impossible to combine
+	 MSAA and Alpha, and GPU selects no Alpha.
+	 Turn off 'optMsaa' to get Alpha working in this case.
+   Uses Datenwolf method from https://stackoverflow.com/questions/4052940
+   Important cite: "You definitely must use XRenderPictFormat..."
+*/
+#define optAlpha 1
+#define optMsaa 0   // 0: Disabled, or 1...4
+int attrListDblMSAlpha[] = {
+	GLX_RENDER_TYPE     , GLX_RGBA_BIT,
+	GLX_DRAWABLE_TYPE   , GLX_WINDOW_BIT,
+	GLX_X_VISUAL_TYPE   , GLX_TRUE_COLOR,
+	GLX_DOUBLEBUFFER    , True,
+	GLX_RED_SIZE        , 4,
+	GLX_GREEN_SIZE      , 4,
+	GLX_BLUE_SIZE       , 4,
+	GLX_ALPHA_SIZE      , (optAlpha) * 4,
+	GLX_DEPTH_SIZE      , 16,
+	GLX_SAMPLE_BUFFERS  , (optMsaa > 0),
+	GLX_SAMPLES         , optMsaa,
+	None
+};
+
